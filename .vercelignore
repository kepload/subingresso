# Ignora file di setup e database nel deploy
*.md
*.sql
SETUP.md
setup-database.sql
.git
.gitignore
.claude
.vercel
node_modules
scripts/.bin
supabase/.temp

# File statico orfano: con cleanUrls intercetta /annuncio e blocca
# il rewrite /annuncio -> /api/annuncio. Il SSR è in api/annuncio.js
# (template inline). NON ripristinare il deploy di questo file.
annuncio.html

# NB: blog.html NON va in .vercelignore. api/blog.js lo legge a runtime
# via fs.readFileSync (path.join(process.cwd(), 'blog.html')) per
# riusarlo come template. Se escluso qui, la function fallisce con
# FUNCTION_INVOCATION_FAILED (testato 7 mag 2026).
# Il rewrite incondizionato `/blog -> /api/blog` ha precedenza sul
# file statico, quindi il deploy come static non causa intercettazione.
