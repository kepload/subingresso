# Ignora file di setup e database nel deploy
*.md
*.sql
SETUP.md
setup-database.sql
.git
.gitignore
.claude
.vercel
node_modules
scripts/.bin
supabase/.temp

# File statico orfano: con cleanUrls intercetta /annuncio e blocca
# il rewrite /annuncio -> /api/annuncio. Il SSR è in api/annuncio.js
# (template inline). NON ripristinare il deploy di questo file.
annuncio.html

# blog.html resta in repo come template (single source of truth per
# l'editing) ma NON viene deployato come file statico, altrimenti con
# cleanUrls intercetta /blog?post= PRIMA del rewrite verso /api/blog
# (testato 7 mag 2026: il rewrite con `has` query non scattava).
# api/blog.js lo legge dal bundle via `includeFiles` in vercel.json e
# fa string-replace sui meta tag head per ogni post.
blog.html
